{
  "name": "jendal-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/oss/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:preprod": "turbo run dev:preprod -F @jendal-workspace/infra",
    "tunnel": "pnpm -F @jendal-workspace/infra tunnel",
    "tunnel:setup": "pnpm -F @jendal-workspace/infra tunnel:setup",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "oxlint && node scripts/check-no-brand.mjs && node scripts/check-oss-boundary.mjs",
    "test": "vitest run",
    "db:push": "turbo run db:push -F @jendal-workspace/db --",
    "db:studio": "turbo run db:studio -F @jendal-workspace/db --",
    "db:generate": "turbo run db:generate -F @jendal-workspace/db --",
    "db:migrate": "turbo run db:migrate -F @jendal-workspace/db --",
    "db:migrate:dev": "pnpm -F @jendal-workspace/infra db:migrate:dev",
    "plugin:zip": "pnpm -F server exec varlock run -- node ../../scripts/build-plugin-zips.ts",
    "deploy:staging": "pnpm -F @jendal-workspace/infra deploy:staging",
    "deploy:production": "pnpm -F @jendal-workspace/infra deploy:production",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@jendal-workspace/config": "workspace:*",
    "@oxlint/plugins": "1.87.0",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "catalog:",
    "oxlint": "1.87.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.30.2"
}
