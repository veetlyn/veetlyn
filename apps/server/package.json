{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "discord:register": "varlock run -- bun src/discord/register.ts",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.7",
    "@hono/trpc-server": "^0.4.2",
    "@jendal-workspace/api": "workspace:*",
    "@jendal-workspace/auth": "workspace:*",
    "@jendal-workspace/channel3": "workspace:*",
    "@jendal-workspace/core": "workspace:*",
    "@jendal-workspace/db": "workspace:*",
    "@jendal-workspace/email": "workspace:*",
    "@jendal-workspace/paypal": "workspace:*",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@trpc/server": "catalog:",
    "aws4fetch": "^1.0.20",
    "better-auth": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.13.12",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@jendal-workspace/config": "workspace:*",
    "@jendal-workspace/infra": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
