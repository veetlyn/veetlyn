{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@jendal-workspace/api": "workspace:*",
    "@jendal-workspace/auth": "workspace:*",
    "@jendal-workspace/db": "workspace:*",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@jendal-workspace/config": "workspace:*",
    "@jendal-workspace/infra": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
