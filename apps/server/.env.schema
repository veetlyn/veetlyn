# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The dashboard origin. Better Auth builds callback URLs from it; http://dash.localhost:3001 in development. Deployed stages
# get it from packages/infra/deploy-hosts.ts.
# @public @type=url
BETTER_AUTH_URL=

# Direct Postgres URL (Render when deployed), used by drizzle-kit and as the Hyperdrive origin. Workers connect through Hyperdrive.
# @type=string(minLength=1)
DATABASE_URL=

# Root domain for admin and store hosts, e.g. example.com; "localhost" in development.
# @public @type=string(minLength=1)
PLATFORM_DOMAIN=localhost

# The product name people read in the UI, emails and the plugin. Renaming the product is a change to this value.
# @public @type=string
PLATFORM_NAME=

# Root domain for storefronts ({slug}.STORE_DOMAIN), e.g. example.app. Defaults to PLATFORM_DOMAIN.
# @public @required=false @type=string
STORE_DOMAIN=

# @public @type=enum(sandbox, live)
PAYPAL_ENVIRONMENT=sandbox

# The stage this Worker runs in, for logs. Set by packages/infra/alchemy.run.ts.
# @public @type=enum(production, staging, dev, preprod)
DEPLOY_STAGE=dev

# @public @type=string(minLength=1)
PAYPAL_CLIENT_ID=

# @type=string(minLength=1)
PAYPAL_CLIENT_SECRET=

# Resend API key (https://resend.com/api-keys), the only email transport until Cloudflare Email Service replaces it.
# Optional so config loads without it; then sign-up still works but every email send fails.
# @required=false @type=string
RESEND_API_KEY=

# Domain of every sender address (accounts@, stores@, invoices@, ...); it must be verified in Resend.
# @public @type=string(minLength=3)
EMAIL_DOMAIN=

# Default Reply-To of every email.
# @public @type=string(minLength=3)
EMAIL_REPLY_TO=

# Partner merchant account ID that issues referrals, and the partner attribution (BN) code.
# Optional: without them the PayPal endpoints answer PRECONDITION_FAILED / 503.
# @required=false @type=string
PAYPAL_PARTNER_ID=

# @required=false @type=string
PAYPAL_ATTRIBUTION_ID=

# The id of the webhook registered on the partner app for this deployment's URL (R1c). Optional: without it
# POST /webhooks/paypal answers 503 and PayPal keeps retrying.
# @required=false @type=string
PAYPAL_WEBHOOK_ID=

# Seals the client secrets teams save for their PayPal payouts app: 32 random bytes in base64
# (openssl rand -base64 32). Optional: without it saving payout credentials and sending payouts answer
# "Payouts are not set up on this server." Changing it makes every saved secret unreadable.
# @required=false @type=string
PAYOUT_CREDENTIALS_KEY=

# The dashboard assistant's model: an OpenAI-compatible chat endpoint (Muse Spark on Modal). Optional: without the
# key, base URL and model the assistant says it is not set up.
# @required=false @type=string
AGENT_API_KEY=

# The endpoint's base URL, e.g. https://<workspace>--<app>.modal.run/v1. Every call sends it the key and the records the
# assistant reads, so it must be the stage's own provider.
# @public @required=false @type=string
AGENT_BASE_URL=

# The model id the endpoint serves.
# @public @required=false @type=string
AGENT_MODEL=

# The questions a team may ask the assistant per UTC day; empty means 200.
# @public @required=false @type=string
AGENT_DAILY_TURNS=

# Channel3 product catalog API key (https://docs.trychannel3.com). Optional: without it the
# "start from a link or photo" and market price features answer "unavailable".
# @required=false @type=string
CHANNEL3_API_KEY=

# @public @type=string(minLength=1)
DISCORD_CLIENT_ID=

# @type=string(minLength=1)
DISCORD_CLIENT_SECRET=

# The application ID from the Discord developer portal; used in interaction webhook and command registration URLs.
# @public @type=string(minLength=1)
DISCORD_APP_ID=

# The application's Ed25519 public key from the developer portal; only ever used to verify interaction signatures.
# @public @type=string(minLength=1)
DISCORD_PUBLIC_KEY=

# @type=string(minLength=1)
DISCORD_BOT_TOKEN=

# Launch access. Deployment defaults: production=waitlist, staging=open.
# @public @required=false @type=enum(waitlist, open)
PUBLIC_ACCESS=

# Address receiving alerts for new waitlist entries. Empty disables new alert creation.
# @required=false @type=email
WAITLIST_NOTIFY_TO=

# Polar sells the workspace subscriptions (billing design, platform/plans/2026-11-02-billing-polar.md). Optional:
# without them checkout, plan changes and the webhook answer that billing is not set up, and workspaces stay on
# their trial. The token is an organization access token; the secret is the webhook endpoint's whsec_ value.
# @public @required=false @type=enum(sandbox, production)
POLAR_SERVER=
# @required=false @type=string
POLAR_ACCESS_TOKEN=
# @required=false @type=string
POLAR_WEBHOOK_SECRET=

# Shared test inbox for walkthroughs (docs/testing.md). Test-only: no code reads these and no stage deploys them.
# The inbox address, <name>@agentmail.to; plus addresses (+client1, ...) land in the same inbox.
# @required=false @sensitive=false @type=email
AGENT_MAIL_INBOX=
# AgentMail API key for that inbox, sent as a Bearer token.
# @required=false @type=string
AGENT_MAIL_API_KEY=
