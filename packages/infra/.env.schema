# @import(../../apps/server/, pick=[NODE_ENV, DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL, PLATFORM_DOMAIN, PLATFORM_NAME, STORE_DOMAIN, PAYPAL_ENVIRONMENT, PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET, PAYPAL_PARTNER_ID, PAYPAL_ATTRIBUTION_ID, PAYPAL_WEBHOOK_ID, DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, DISCORD_APP_ID, DISCORD_PUBLIC_KEY, DISCORD_BOT_TOKEN, RESEND_API_KEY, EMAIL_DOMAIN, EMAIL_REPLY_TO, CHANNEL3_API_KEY, PAYOUT_CREDENTIALS_KEY])
# @defaultRequired=false
# @defaultSensitive=true
# ---
ALCHEMY_PASSWORD=

# The product name, passed to both Workers.
# @type=string
PLATFORM_NAME=

# Zones the deployed stages serve: the platform site and dashboard, and the seller storefronts.
# @public @type=string
PLATFORM_ZONE=
# @public @type=string
STORE_ZONE=

# Mail defaults to PLATFORM_ZONE (and support@<PLATFORM_ZONE>) in alchemy.run.ts unless set here.
# @public @required=false @type=string
EMAIL_DOMAIN=
# @public @required=false @type=string
EMAIL_REPLY_TO=

# Deploy credentials: GitHub environments in CI, this file for a deploy from your machine.
CLOUDFLARE_API_TOKEN=
# @public
CLOUDFLARE_ACCOUNT_ID=
# Zone of the store domain, for the seller-site wildcard record (production only).
# @public
CLOUDFLARE_STORE_ZONE_ID=
# Seller slugs served on staging as {slug}.staging.<store zone>, comma-separated.
# @public
STAGING_STORE_SLUGS=

# Domain the named tunnel serves (pnpm tunnel) with the production layout: web on D and *.D, api on api.D.
# Leave empty to reach the local stages on localhost only.
# @public
TUNNEL_DOMAIN=

# Store domain the tunnel serves as *.S, like STORE_DOMAIN in production (e.g. example.app). Defaults to TUNNEL_DOMAIN.
# @public
TUNNEL_STORE_DOMAIN=

# Local stage that owns TUNNEL_DOMAIN; the other stage stays on localhost.
# @public @type=enum(dev, preprod)
TUNNEL_STAGE=dev

# Local Postgres used by `pnpm dev` and `pnpm dev:preprod` as the Hyperdrive dev origin (no TLS).
# Deployed stages use DATABASE_URL (Render Postgres) through the Hyperdrive service. Migrate it with `pnpm db:migrate:dev`.
DEV_DATABASE_URL=

# PayPal sandbox personal (buyer) and business (seller) accounts for walkthroughs and browser tests.
# Never bound to a Worker. Buyer 1 is also the login the sandbox banner shows; buyers 2 and 3 stay private.
SANDBOX_BUYER_1_EMAIL=
SANDBOX_BUYER_1_PASSWORD=
SANDBOX_BUYER_2_EMAIL=
SANDBOX_BUYER_2_PASSWORD=
SANDBOX_BUYER_3_EMAIL=
SANDBOX_BUYER_3_PASSWORD=
SANDBOX_SELLER_1_EMAIL=
SANDBOX_SELLER_1_PASSWORD=
SANDBOX_SELLER_2_EMAIL=
SANDBOX_SELLER_2_PASSWORD=
SANDBOX_SELLER_3_EMAIL=
SANDBOX_SELLER_3_PASSWORD=

# Sandbox buyer login and test card shown on checkout pages. Sandbox-only values, meant to be public.
# Leave any of them empty and the banner shows only its default text.
# @public
SANDBOX_BUYER_EMAIL=${SANDBOX_BUYER_1_EMAIL}
# @public
SANDBOX_BUYER_PASSWORD=${SANDBOX_BUYER_1_PASSWORD}
# @public
SANDBOX_CARD_NUMBER=
# @public
SANDBOX_CARD_EXPIRY=
# @public
SANDBOX_CARD_CVV=

# Slug of the seeded demo store, linked from the landing page. Leave empty to hide the link.
# @public
DEMO_STORE_SLUG=

# Optional launch override. Omit for production=waitlist and staging=open.
# @public @type=enum(waitlist, open)
PUBLIC_ACCESS=
