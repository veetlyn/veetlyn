# @import(../../apps/server/, pick=[NODE_ENV, DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL, PLATFORM_DOMAIN, STORE_DOMAIN, PAYPAL_ENVIRONMENT, PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET, PAYPAL_PARTNER_ID, PAYPAL_ATTRIBUTION_ID, SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, EMAIL_FROM])
# @defaultRequired=false
# @defaultSensitive=true
# ---
ALCHEMY_PASSWORD=

# Domain the named tunnel serves (pnpm tunnel) with the production layout: web on D and *.D, api on api.D.
# Leave empty to reach the local stages on localhost only.
# @public
TUNNEL_DOMAIN=

# Local stage that owns TUNNEL_DOMAIN; the other stage stays on localhost.
# @public @type=enum(dev, preprod)
TUNNEL_STAGE=dev

# Local Postgres used by `pnpm dev` and `pnpm dev:preprod` as the Hyperdrive dev origin (no TLS).
# Deployed stages use DATABASE_URL (Aiven) through the Hyperdrive service. Migrate it with `pnpm db:migrate:dev`.
DEV_DATABASE_URL=

# Sandbox buyer login and test card shown on checkout pages. Sandbox-only values, meant to be public.
# Leave any of them empty and the banner shows only its default text.
# @public
SANDBOX_BUYER_EMAIL=
# @public
SANDBOX_BUYER_PASSWORD=
# @public
SANDBOX_CARD_NUMBER=
# @public
SANDBOX_CARD_EXPIRY=
# @public
SANDBOX_CARD_CVV=

# Slug of the seeded demo store, linked from the landing page. Leave empty to hide the link.
# @public
DEMO_STORE_SLUG=
