# @import(../../apps/server/, pick=[NODE_ENV, DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL, PLATFORM_DOMAIN, PAYPAL_ENVIRONMENT, PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET])
# @defaultRequired=false
