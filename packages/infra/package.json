{
  "name": "@jendal-workspace/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "JENDAL_LOCAL_STAGE=dev alchemy dev --stage dev",
    "dev:preprod": "JENDAL_LOCAL_STAGE=preprod alchemy dev --stage preprod",
    "tunnel": "node scripts/tunnel.ts run",
    "tunnel:setup": "node scripts/tunnel.ts setup",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@jendal-workspace/config": "workspace:*",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.115",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
